{
  "manifest_version": 3,
  "name": "LifeKit – Everyday Tools",
  "short_name": "LifeKit",
  "version": "1.0.0",
  "description": "Quick access to 60+ free, private tools: PDF to Word, sign PDFs, resize images, calculators, timers, notes and more.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "LifeKit tools",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open LifeKit"
    }
  }
}
